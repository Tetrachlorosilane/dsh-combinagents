{
  "name": "@dsh-external/dsh-combinagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Overlay reporting compositions for DSH agents and subagents that preserve each session's workspace, sandbox mode, and permissions.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "agents",
    "subagents",
    "composition"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./graph": "./src/graph.js",
    "./clone": "./src/clone.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-subagent",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js src/graph.js src/clone.js src/store.js src/discovery.js src/manager.js src/http.js src/controls.js client.js"
  }
}
